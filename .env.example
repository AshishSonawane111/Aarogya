# Health Passport Global Environment Variables
PORT=5000
NODE_ENV=development

# Frontend Base URL
CLIENT_URL=http://localhost:5173

# Supabase Configuration (Optional for local mode; required for live cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for fallback auth token signing
JWT_SECRET=health_passport_super_secret_jwt_key_2026

# Optional AI API Key (Gemini or OpenAI). If omitted, built-in intelligent medical heuristic engine handles requests.
GEMINI_API_KEY=
OPENAI_API_KEY=
